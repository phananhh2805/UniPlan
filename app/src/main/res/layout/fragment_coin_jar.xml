<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tv_month_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lọ thành tựu tháng"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_coin_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 / 30 xu"
        android:textSize="16sp"
        android:layout_marginTop="4dp"
        android:textColor="?android:attr/textColorSecondary" />

    <com.uniplan.app.ui.jar.CoinJarView
        android:id="@+id/coin_jar_view"
        android:layout_width="280dp"
        android:layout_height="360dp"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tv_motivational"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lọ còn trống, việc đầu tiên đang chờ bạn"
        android:layout_marginTop="20dp"
        android:textStyle="italic" />

</LinearLayout>
